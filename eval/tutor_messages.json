[
  {"id": "frane-1", "level": "tiro", "text": "PUELLA ROSAM AMANT.", "error": ["AMANT", "AMAT"]},
  {"id": "frane-2", "level": "tiro", "text": "SALUE! QUID AGIS? QUIS ES?", "identity": true},

  {"id": "greet-1", "level": "tiro", "text": "SALUE, MAGISTER!"},
  {"id": "greet-2", "level": "tiro", "text": "QUID AGIS?"},
  {"id": "greet-3", "level": "tiro", "text": "SALUE! BENE UALEO. ET TU?"},
  {"id": "greet-4", "level": "medius", "text": "SALUE, MAGISTER. HODIE LAETUS SUM."},
  {"id": "greet-5", "level": "medius", "text": "AUE! QUOMODO UALES HODIE?"},
  {"id": "greet-6", "level": "tiro", "text": "UALE, MAGISTER! CRAS UENIAM."},
  {"id": "greet-7", "level": "peritus", "text": "SALUE, MI MAGISTER. DIU TE NON UIDI."},

  {"id": "id-1", "level": "tiro", "text": "QUIS ES?", "identity": true},
  {"id": "id-2", "level": "tiro", "text": "QUOD EST NOMEN TIBI?", "identity": true},
  {"id": "id-3", "level": "medius", "text": "QUIS ES TU, ET QUID FACIS?", "identity": true},
  {"id": "id-4", "level": "medius", "text": "ESNE MAGISTER MEUS?", "identity": true},
  {"id": "id-5", "level": "peritus", "text": "DIC MIHI, QUIS ES ET UNDE UENIS?", "identity": true},
  {"id": "id-6", "level": "tiro", "text": "TU ES CLAUDIUS?", "identity": true},

  {"id": "talk-1", "level": "tiro", "text": "HODIE PLUIT."},
  {"id": "talk-2", "level": "tiro", "text": "EGO CANEM HABEO."},
  {"id": "talk-3", "level": "tiro", "text": "PATER MEUS AGRICOLA EST."},
  {"id": "talk-4", "level": "tiro", "text": "PANEM ET CASEUM AMO."},
  {"id": "talk-5", "level": "medius", "text": "HERI CUM AMICIS IN FORO AMBULAUI."},
  {"id": "talk-6", "level": "medius", "text": "CRAS AD UILLAM AUI MEI IBO."},
  {"id": "talk-7", "level": "medius", "text": "IN SCHOLA HODIE MULTA DIDICI."},
  {"id": "talk-8", "level": "medius", "text": "LIBROS DE BELLO TROIANO LEGERE MIHI PLACET."},
  {"id": "talk-9", "level": "peritus", "text": "HESTERNO DIE CICERONIS EPISTULAS LEGEBAM, QUARUM STILUS MIHI MAXIME PLACUIT."},
  {"id": "talk-10", "level": "peritus", "text": "QUID DE UERGILIO SENTIS? EGO AENEIDEM ADMIROR."},
  {"id": "talk-11", "level": "tiro", "text": "SOROR MEA PARUA EST."},
  {"id": "talk-12", "level": "medius", "text": "HODIE SOL LUCET ET CAELUM SERENUM EST."},
  {"id": "talk-13", "level": "tiro", "text": "EQUUM ALBUM UIDEO."},
  {"id": "talk-14", "level": "medius", "text": "QUOT MILITES IN LEGIONE ERANT?"},
  {"id": "talk-15", "level": "peritus", "text": "CUR ROMANI TOT BELLA GESSERUNT?"},

  {"id": "sv-1", "level": "tiro", "text": "MILITES URBEM DEFENDIT.", "error": ["DEFENDIT", "DEFENDUNT"]},
  {"id": "sv-2", "level": "tiro", "text": "PUERI IN HORTO LUDIT.", "error": ["LUDIT", "LUDUNT"]},
  {"id": "sv-3", "level": "tiro", "text": "MAGISTER DISCIPULOS DOCENT.", "error": ["DOCENT", "DOCET"]},
  {"id": "sv-4", "level": "medius", "text": "AMICI MEI HERI UENIT.", "error": ["UENIT", "UENERUNT"]},
  {"id": "sv-5", "level": "medius", "text": "SERUUS IN AGRO LABORANT.", "error": ["LABORANT", "LABORAT"]},
  {"id": "sv-6", "level": "tiro", "text": "PUELLAE CANTAT.", "error": ["CANTAT", "CANTANT"]},

  {"id": "case-1", "level": "tiro", "text": "EGO PUELLA UIDEO.", "error": ["PUELLA", "PUELLAM"]},
  {"id": "case-2", "level": "tiro", "text": "MARCUS EPISTULA SCRIBIT.", "error": ["EPISTULA", "EPISTULAM"]},
  {"id": "case-3", "level": "medius", "text": "HERI CUM PATREM MEO IN FORUM IUI.", "error": ["PATREM", "PATRE"]},
  {"id": "case-4", "level": "tiro", "text": "PUER CANIS AMAT.", "error": ["CANIS", "CANEM"]},
  {"id": "case-5", "level": "medius", "text": "IN URBEM MAGNAM HABITO.", "error": ["URBEM", "URBE"]},
  {"id": "case-6", "level": "tiro", "text": "DOMINUS SERUUS UOCAT.", "error": ["SERUUS", "SERUUM"]},

  {"id": "adj-1", "level": "tiro", "text": "ROSAM PULCHRA UIDEO.", "error": ["PULCHRA", "PULCHRAM"]},
  {"id": "adj-2", "level": "medius", "text": "PUERI BONUS SUNT.", "error": ["BONUS", "BONI"]},
  {"id": "adj-3", "level": "medius", "text": "IN HORTO MAGNUM AMBULO.", "error": ["MAGNUM", "MAGNO"]},
  {"id": "adj-4", "level": "tiro", "text": "EQUUS ALBAM CURRIT.", "error": ["ALBAM", "ALBUS"]},

  {"id": "verb-1", "level": "tiro", "text": "EGO LIBRUM LEGIT.", "error": ["LEGIT", "LEGO"]},
  {"id": "verb-2", "level": "tiro", "text": "TU BENE CANTO.", "error": ["CANTO", "CANTAS"]},
  {"id": "verb-3", "level": "medius", "text": "HERI AD SCHOLAM AMBULO.", "error": ["AMBULO", "AMBULAUI"]},
